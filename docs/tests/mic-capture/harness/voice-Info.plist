<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- rd-voice-probe.app: the voice-processing measurement as its own app, so microphone
     access is asked for and granted to it alone. No Dock icon. -->
<plist version="1.0">
<dict>
    <key>CFBundleIdentifier</key>
    <string>app.remotedisplay.spike.voice-probe</string>
    <key>CFBundleName</key>
    <string>rd-voice-probe</string>
    <key>CFBundleExecutable</key>
    <string>rd-voice-probe</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>LSUIElement</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Remote Display's echo test records from your microphone while it plays speech, and keeps nothing.</string>
</dict>
</plist>
