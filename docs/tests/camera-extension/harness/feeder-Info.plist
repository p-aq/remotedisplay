<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!-- Embedded into rd-camera-feeder's __TEXT,__info_plist. rd-camera-feeder-bare has
     none, so the two binaries answer issue #7: does a sink-only feeder need the
     Camera permission? -->
<dict>
    <key>CFBundleIdentifier</key>
    <string>app.remotedisplay.spike.feeder</string>
    <key>CFBundleName</key>
    <string>rd-camera-feeder</string>
    <key>NSCameraUsageDescription</key>
    <string>Feeds a Remote Display controller's camera into Remote Display Camera.</string>
</dict>
</plist>
